.nav-link:hover {
    color: var(--gold);
}

.home-pill {
    background: linear-gradient(135deg, var(--gold), var(--gold-dark));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    padding: 12px 34px;
