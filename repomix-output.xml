  border: 1px solid rgba(255,153,51,0.18);
  box-shadow: 0 8px 32px -8px rgba(0,0,0,0.12), 0 0 0 1px rgba(255,153,51,0.08) inset;
  background: var(--navy-light);
  transition: box-shadow var(--transition-base);
}

.map-embed-wrapper:hover {
  box-shadow: 0 12px 40px -10px rgba(255,153,51,0.18), 0 0 0 1px rgba(255,153,51,0.15) inset;
}

.map-embed-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.7rem 1rem;
  background: rgba(255,153,51,0.07);
  border-bottom: 1px solid rgba(255,153,51,0.12);
}

.map-pin-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 0.01em;
}

.map-live-badge {
  font-size: 0.75rem;
  font-weight: 600;
  color: #22c55e;
  background: rgba(34,197,94,0.12);
  border: 1px solid rgba(34,197,94,0.25);
