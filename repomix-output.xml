        inset 0 1px 0 rgba(255, 255, 255, 0.2);
    
    position: relative;
    text-decoration: none;
    display: inline-block;
}

.home-pill::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: linear-gradient(145deg, rgba(255,255,255,0.15), transparent 70%);
