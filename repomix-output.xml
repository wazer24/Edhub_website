}

@keyframes pulse-badge {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.map-frame {
  position: relative;
  width: 100%;
  overflow: hidden;
  line-height: 0;
}

.map-frame iframe {
  filter: saturate(0.9) contrast(1.05);
  transition: filter var(--transition-base);
}

.map-frame:hover iframe {
