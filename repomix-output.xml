  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 48px;
}

.contact-channel h4 { font-size: 0.95rem; margin-bottom: var(--space-xs); }
.contact-channel p { color: var(--text-secondary); font-size: 0.9rem; }

.contact-form {
  background: var(--navy-light);
  border: 1px solid rgba(0,0,0,0.06);
  border-radius: var(--radius-lg);
