/* ==========================
   ANIMATIONS
   ========================== */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in-up {
  animation: fadeInUp 0.7s ease forwards;
}

/* --- Scrollbar --- */
::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: var(--navy); }
::-webkit-scrollbar-thumb { background: var(--navy-mid); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: var(--navy-surface); }

/* ==========================
   3D MARQUEE TESTIMONIALS
   ========================== */
.marquee-3d-section {
  position: relative;
  display: flex;
  height: 600px;
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  perspective: 500px;
  margin-top: var(--space-xl);
}

.marquee-3d-wrapper {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-md);
  transform: translateX(-50px) translateY(0px) translateZ(-100px) rotateX(15deg) rotateY(-10deg) rotateZ(15deg);
}

.marquee-container {
  display: flex;
  overflow: hidden;
  user-select: none;
  gap: var(--space-md);
}

.marquee-container.vertical {
  flex-direction: column;
}

.marquee-track {
  flex-shrink: 0;
  display: flex;
  justify-content: space-around;
  gap: var(--space-md);
  min-width: 100%;
  animation: scroll var(--duration, 40s) linear infinite;
}

.marquee-container.vertical .marquee-track {
  min-height: 100%;
  flex-direction: column;
  animation: scroll-vertical var(--duration, 40s) linear infinite;
}

.marquee-container.reverse .marquee-track {
  animation-direction: reverse;
}

.marquee-container.pause-on-hover:hover .marquee-track {
  animation-play-state: paused;
}

@keyframes scroll {
  from { transform: translateX(0); }
  to { transform: translateX(calc(-100% - var(--space-md))); }
}

@keyframes scroll-vertical {
  from { transform: translateY(0); }
  to { transform: translateY(calc(-100% - var(--space-md))); }
}

.review-card {
  position: relative;
  height: max-content;
  width: 320px;
  cursor: default;
  overflow: hidden;
  border-radius: var(--radius-lg);
  border: 1px solid rgba(0, 0, 0, 0.08);
  background: var(--navy-light);
  padding: var(--space-lg);
  transition: all var(--transition-base);
}

.review-card:hover {
  background: var(--navy-surface);
  border-color: rgba(245, 166, 35, 0.2);
  transform: translateY(-2px);
}

.review-card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}

.review-card-avatar {
  border-radius: 50%;
  width: 40px;
  height: 40px;
  min-width: 40px;
  background: linear-gradient(135deg, var(--gold), var(--teal));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: var(--navy);
  font-size: 0.9rem;
}

.review-card-author {
  display: flex;
  flex-direction: column;
}

.review-card-name {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--white);
}

.review-card-username {
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--teal);
}

.review-card-body {
  font-size: 0.9rem;
  line-height: 1.6;
  color: var(--text-secondary);
  font-style: italic;
}

.fade-top, .fade-bottom, .fade-left, .fade-right {
  pointer-events: none;
  position: absolute;
  z-index: 10;
}

.fade-top {
  top: 0; left: 0; right: 0; height: 15%;
  background: linear-gradient(to bottom, var(--navy), transparent);
}

.fade-bottom {
  bottom: 0; left: 0; right: 0; height: 15%;
  background: linear-gradient(to top, var(--navy), transparent);
}

.fade-left {
  top: 0; bottom: 0; left: 0; width: 10%;
  background: linear-gradient(to right, var(--navy), transparent);
}

.fade-right {
  top: 0; bottom: 0; right: 0; width: 10%;
  background: linear-gradient(to left, var(--navy), transparent);
}

/* ==========================
   CYBER STATS (Hacker style)
   ========================== */
.cyber-stats-section {
  background: #000;
  padding: var(--space-4xl) 0;
  border-top: 1px solid rgba(255, 51, 51, 0.2);
  border-bottom: 1px solid rgba(255, 51, 51, 0.2);
}

.cyber-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-2xl);
}

@media (max-width: 992px) {
  .cyber-stats-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 576px) {
  .cyber-stats-grid { grid-template-columns: 1fr; }
}

.cyber-stat-card {
  border: 1px solid var(--gold);
  background: #000;
  padding: var(--space-2xl) var(--space-lg);
  text-align: center;
  color: var(--gold);
