.apply-cta:hover {
    background: linear-gradient(135deg, var(--gold), var(--gold-dark));
    color: #ffffff;
    border-color: transparent;
    box-shadow: 0 0 30px -6px rgba(255, 153, 51, 0.5);
    transform: scale(1.05);
}

@media (max-width: 1024px) {
    .floating-pill {
        padding: 16px 28px;
        max-width: 96vw;
        gap: 2rem;
    }
    .nav-links {
        gap: 1.5rem;
    }
    .nav-link, .home-pill, .apply-cta {
        font-size: 1.05rem;
    }
