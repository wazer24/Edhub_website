.floating-pill.scrolled {
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 
        0 8px 32px -8px rgba(0, 0, 0, 0.15),
        0 0 1px 1px rgba(255, 153, 51, 0.2) inset;
}

.nav-content {
