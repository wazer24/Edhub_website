  width: 300px;
  height: 300px;
  background: radial-gradient(ellipse at 50% 80%, rgba(255,153,51,0.22) 0%, rgba(255,153,51,0.06) 55%, transparent 75%);
  border-radius: 50%;
  z-index: 0;
  pointer-events: none;
}

/* Bottom pill platform */
.hero-image-frame::after {
  content: '';
  position: absolute;
  bottom: -8px;
  left: 50%;
  transform: translateX(-50%);
  width: 220px;
  height: 14px;
  background: linear-gradient(90deg, transparent, rgba(255,153,51,0.25), transparent);
  border-radius: 50%;
  filter: blur(6px);
  z-index: 0;
}

.main-subject-img {
  width: 100%;
  max-width: 340px;
  height: auto;
  object-fit: contain;
  object-position: top center;
  display: block;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 24px 36px rgba(255,153,51,0.15)) drop-shadow(0 8px 12px rgba(0,0,0,0.08));
  animation: heroFloat 5s ease-in-out infinite;
}

@keyframes heroFloat {
  0%, 100% { transform: translateY(0px); }
  50%       { transform: translateY(-10px); }
}

/* ─── Floating badge (LIVE CLASSES) ─── */
.floating-badge {
  position: absolute;
  top: 18%;
  right: -14%;
  display: flex;
  align-items: center;
  gap: 8px;
  background: #ffffff;
  border: 1px solid rgba(255,153,51,0.25);
  border-radius: var(--radius-full);
  padding: 10px 20px;
  font-family: var(--font-heading);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 1.8px;
  color: var(--gold-dark);
  box-shadow: 0 6px 24px rgba(0,0,0,0.08), 0 0 0 1px rgba(255,153,51,0.1);
  z-index: 6;
  animation: floatBadge 3.5s ease-in-out infinite;
  white-space: nowrap;
}

.pulse-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--gold);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255,153,51,0.5); }
  50%       { box-shadow: 0 0 0 8px rgba(255,153,51,0); }
}

@keyframes floatBadge {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-8px); }
}

/* ─── Stats chip (bottom-left) ─── */
.secondary-subject {
  position: absolute;
  bottom: 10%;
  left: -12%;
  z-index: 6;
}

.color-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  background: #ffffff;
  border: 1px solid rgba(255,153,51,0.2);
  border-radius: var(--radius-lg);
  padding: 14px 20px;
  box-shadow: 0 8px 28px rgba(0,0,0,0.08);
  animation: floatBadge 4.2s ease-in-out infinite reverse;
  white-space: nowrap;
}

.color-block-number {
  font-family: var(--font-heading);
  font-size: 1.6rem;
  font-weight: 900;
  color: var(--gold);
  line-height: 1;
}

.color-block-label {
  font-size: 0.7rem;
  font-weight: 600;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* ─── Responsive ─── */
@media (max-width: 1024px) {
  .hero-grid {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
  }

  .hero-image-frame {
    width: 290px;
  }

  .main-subject-img {
    max-width: 290px;
  }

  .floating-badge {
    right: -8%;
  }
}

@media (max-width: 768px) {
  .hero {
    min-height: auto;
    padding-bottom: var(--space-4xl);
  }

  .hero-grid {
    grid-template-columns: 1fr;
    text-align: center;
    gap: var(--space-2xl);
    padding: var(--space-xl) 0 var(--space-3xl);
  }

  .hero-content-col {
    order: 1;
  }

  .hero-visual-col {
    order: 2;
    min-height: 380px;
  }

  .hero-eyebrow {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-subheading {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-button-group {
    justify-content: center;
  }

  .trust-signals {
    justify-content: center;
  }

  .hero-image-frame {
    width: 260px;
  }

  .main-subject-img {
    max-width: 260px;
  }

  .hero-shape {
    width: 320px;
    height: 320px;
  }

  .floating-badge {
    right: -4%;
    top: 12%;
  }

  .secondary-subject {
    left: -4%;
  }
}

@media (max-width: 480px) {
  .hero-heading {
    font-size: 2.1rem;
  }

  .hero-button-group {
    flex-direction: column;
    align-items: center;
  }

  .hero-button-group .btn {
    width: 100%;
    justify-content: center;
  }

  .trust-signals {
    flex-direction: column;
    gap: var(--space-sm);
  }

  .divider-vertical {
    display: none;
  }

  .hero-shape {
    width: 260px;
    height: 260px;
  }

  .hero-image-frame {
    width: 220px;
  }

  .main-subject-img {
    max-width: 220px;
  }

  .floating-badge {
    font-size: 0.65rem;
    padding: 8px 14px;
    right: 0;
  }

  .secondary-subject {
    left: 0;
  }
}
