/* =====================================================
   PREMIUM WORD PRELOADER
   ===================================================== */

.preloader-overlay {
  position: fixed;
  inset: 0;
  background: #0a0a0a;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* ── Exit animation ── */
.preloader-overlay.preloader-exit {
  animation: preloaderSlideOut 0.7s cubic-bezier(0.86, 0, 0.07, 1) forwards;
}

@keyframes preloaderSlideOut {
  0%   { transform: translateY(0); opacity: 1; }
  100% { transform: translateY(-100vh); opacity: 1; }
}

/* ── Animated scan lines ── */
.preloader-lines {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.preloader-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background: rgba(255, 153, 51, 0.06);
  top: calc(16.66% * (var(--i) + 1));
  animation: scanline 3s ease-in-out infinite;
  animation-delay: calc(var(--i) * 0.4s);
}

@keyframes scanline {
  0%   { opacity: 0; transform: scaleX(0); transform-origin: left; }
  40%  { opacity: 1; transform: scaleX(1); }
  60%  { opacity: 1; transform: scaleX(1); }
  100% { opacity: 0; transform: scaleX(0); transform-origin: right; }
}

/* ── Corner brackets ── */
.preloader-corner {
  position: absolute;
  width: 28px;
  height: 28px;
  opacity: 0.5;
  animation: cornerPulse 2s ease-in-out infinite alternate;
}
.preloader-corner.tl { top: 24px; left: 24px;  border-top: 2px solid var(--gold); border-left: 2px solid var(--gold); }
.preloader-corner.tr { top: 24px; right: 24px;  border-top: 2px solid var(--gold); border-right: 2px solid var(--gold); }
.preloader-corner.bl { bottom: 24px; left: 24px;  border-bottom: 2px solid var(--gold); border-left: 2px solid var(--gold); }
.preloader-corner.br { bottom: 24px; right: 24px;  border-bottom: 2px solid var(--gold); border-right: 2px solid var(--gold); }

@keyframes cornerPulse {
  from { opacity: 0.3; }
  to   { opacity: 0.8; }
}

/* ── Stage: word stack ── */
.preloader-stage {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.1em;
  text-align: center;
}

/* ── Individual word slots ── */
.preloader-word {
  display: block;
  font-family: 'Outfit', 'Segoe UI', sans-serif;
  font-size: clamp(3rem, 10vw, 7rem);
  font-weight: 900;
  letter-spacing: -0.02em;
  line-height: 1.05;
  overflow: hidden;
  user-select: none;
  pointer-events: none;
  transition: color 0.3s ease;
}

/* Past: greyed out */
.preloader-word.pw-past {
  color: rgba(255,255,255,0.12);
}

/* Active: blazing saffron with glow */
.preloader-word.pw-active {
  color: #FF9933;
  text-shadow: 0 0 40px rgba(255,153,51,0.5), 0 0 80px rgba(255,153,51,0.2);
}

/* Future: nearly invisible */
.preloader-word.pw-future {
  color: rgba(255,255,255,0.05);
}

/* Symbol (✦) special treatment */
.preloader-word.pw-symbol {
  font-size: clamp(2rem, 6vw, 4rem);
}

.pw-spark {
  display: inline-block;
  animation: sparkSpin 0.8s ease forwards;
}

@keyframes sparkSpin {
  0%   { transform: scale(0) rotate(-90deg); opacity: 0; }
  60%  { transform: scale(1.3) rotate(15deg); opacity: 1; }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}

/* ── Per-character stagger animation ── */
.pw-char {
  display: inline-block;
  opacity: 0;
  transform: translateY(30px);
  animation: charRise 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  animation-delay: calc(var(--ci) * 40ms);
}

.pw-active .pw-char {
  animation-name: charRise;
}

.pw-past .pw-char,
.pw-future .pw-char {
  /* No per-char animation for non-active words */
  animation: none;
  opacity: 1;
  transform: none;
}

@keyframes charRise {
  0%   { opacity: 0; transform: translateY(30px) skewY(4deg); }
  60%  { opacity: 1; transform: translateY(-4px) skewY(-1deg); }
  100% { opacity: 1; transform: translateY(0) skewY(0deg); }
}

/* ── Progress bar ── */
.preloader-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: rgba(255,255,255,0.06);
}

.preloader-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF9933, #FFB366);
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 0 12px rgba(255,153,51,0.6);
}
