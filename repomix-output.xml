}

.lead-magnet-card h4 { font-size: 1rem; margin-bottom: var(--space-sm); }
.lead-magnet-card p { font-size: 0.85rem; color: var(--text-secondary); margin-bottom: var(--space-lg); }

/* Map Embed */
.map-embed-wrapper {
  width: 100%;
  border-radius: var(--radius-lg);
